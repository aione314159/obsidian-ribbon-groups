{
  "name": "open-ribbon-groups-obsidian-plugin",
  "version": "1.1.0",
  "description": "Group the buttons in the left ribbon into labeled, color-coded sections, and reorder them by dragging.",
  "main": "dist/main.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('manifest.json','dist/manifest.json')\"",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "author": "aione"
}
